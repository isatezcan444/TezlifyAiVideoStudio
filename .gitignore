# Stage 5.4 — isolated alignment environment (torch/transformers, ~1.3 GB)
# and the HuggingFace model cache (~2.4 GB). Both are re-creatable with
# scripts/setup_alignment_env.sh and must never enter git history.
tools/alignment-venv/
tools/hf-cache/
tools/alignment_probe/*.wav
tools/alignment_probe/*.log

# Local speech alignment results (content-addressed cache, re-derivable)
data/alignment_cache/

# Stage 5.5 — raw render frames are ~1.8 GB and re-derivable with
# evidence/stage_5_5/render_story_evidence.py. The sampled contact sheets and
# story_evidence.json stay tracked.
evidence/stage_5_5/story/renders/*/stage55_story/frames/
evidence/stage_5_5/.data/
