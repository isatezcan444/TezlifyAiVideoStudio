# Tezlify AI Video Studio - Environment Configuration
APP_NAME="Tezlify AI Video Studio"
APP_ENV="development"
DEBUG=true

# Server Configuration
HOST="127.0.0.1"
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Storage Paths (Local Filesystem)
# If empty, defaults to local project data directory: ./data
DATA_DIR="./data"
MAX_UPLOAD_SIZE_MB=500

# CORS Configuration
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Future Integration Placeholders (Not active in Stage 1)
# YOUTUBE_CLIENT_ID=""
# YOUTUBE_CLIENT_SECRET=""
# OPENAI_API_KEY=""
