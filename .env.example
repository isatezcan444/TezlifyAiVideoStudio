# Tezlify AI Video Studio - Environment Configuration
APP_NAME="Tezlify AI Video Studio"
APP_ENV="development"
DEBUG=true

# Server Configuration
HOST="127.0.0.1"
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Storage Paths (Local Filesystem)
# If empty, defaults to local project data directory: ./data
DATA_DIR="./data"
MAX_UPLOAD_SIZE_MB=500

# CORS Configuration
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# YouTube Data API v3 & Google OAuth 2.0 (Aşama 2)
# Google Cloud Console -> APIs & Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://127.0.0.1:8000/api/v1/social/youtube/callback"

# ElevenLabs AI Voice Integration (Aşama 4.4)
# ElevenLabs Console -> Profile -> API Keys
ELEVENLABS_API_KEY=""
ELEVENLABS_DEFAULT_MODEL="eleven_multilingual_v2"

# Phoneme / Viseme Lip Sync (Aşama 5.4)
# Alignment runs locally on the CPU through an isolated Python environment;
# no audio leaves this machine. Build it once with:
#   bash scripts/setup_alignment_env.sh
# Set LIP_SYNC_ENABLED=false to render with the legacy mouth animation instead.
LIP_SYNC_ENABLED="true"
ALIGNMENT_VENV_DIR="./tools/alignment-venv"
ALIGNMENT_MODEL_ID="Baybars/wav2vec2-xls-r-300m-cv8-turkish"
ALIGNMENT_TIMEOUT_SECONDS=600

# Gelecek Entegrasyonlar (Sonraki Aşamalar)
# OPENAI_API_KEY=""

