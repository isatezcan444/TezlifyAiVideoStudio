# Tezlify AI Video Studio - Environment Configuration
APP_NAME="Tezlify Creator Studio"
APP_ENV="development"
DEBUG=true

# Server Configuration
HOST="127.0.0.1"
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Storage Paths (Local Filesystem)
# If empty, defaults to local project data directory: ./data
DATA_DIR="./data"
MAX_UPLOAD_SIZE_MB=500

# CORS Configuration
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# YouTube Data API v3 & Google OAuth 2.0 (Aşama 2)
# Google Cloud Console -> APIs & Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://127.0.0.1:8000/api/v1/social/youtube/callback"

# Gelecek Entegrasyonlar (Sonraki Aşamalar)
# OPENAI_API_KEY=""

